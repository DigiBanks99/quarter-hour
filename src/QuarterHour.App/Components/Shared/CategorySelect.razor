@inject WorkspaceService Workspace

<MudSelect T="string" Value="@(Value ?? (NullText is null ? null : NullValue))" ValueChanged="OnChanged" Label="@Label" Dense="true" Margin="Margin.Dense" Variant="Variant" Placeholder="@Placeholder"
           Clearable="false" FullWidth="true" Class="@Class" AnchorOrigin="Origin.BottomLeft" ToStringFunc="Display">
    @if (NullText is not null)
    {
        <MudSelectItem T="string" Value="@NullValue"><span class="qh-muted">@NullText</span></MudSelectItem>
    }
    @if (IncludeNotRelevant)
    {
        <MudSelectItem T="string" Value="@DirectMappings.NotRelevantTarget"><span class="qh-muted">🚫 Not relevant</span></MudSelectItem>
    }
    @foreach (Category category in Workspace.ActiveCategories)
    {
        <MudSelectItem T="string" Value="@category.Id"><CategoryLabel Category="category" ShowBillable="true" /></MudSelectItem>
    }
</MudSelect>

@code {
    /// <summary>Stands in for "no value" inside the select, which can't hold null items reliably.</summary>
    private const string NullValue = "__none__";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? NullText { get; set; }
    [Parameter] public bool IncludeNotRelevant { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public string? Class { get; set; }

    private string Display(string? id) => id switch
    {
        null or NullValue => NullText ?? "",
        DirectMappings.NotRelevantTarget => "Not relevant",
        _ => Workspace.Config.FindCategory(id)?.DisplayName ?? "(deleted category)",
    };

    private Task OnChanged(string? value) => ValueChanged.InvokeAsync(value == NullValue ? null : value);
}
