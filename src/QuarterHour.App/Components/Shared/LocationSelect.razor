@inject WorkspaceService Workspace

<MudSelect T="string" Value="@(Value ?? NullValue)" ValueChanged="OnChanged" Label="@Label" Dense="true" Margin="Margin.Dense" Variant="Variant"
           FullWidth="true" Class="@Class" AnchorOrigin="Origin.BottomLeft" ToStringFunc="Display">
    @if (NullText is not null)
    {
        <MudSelectItem T="string" Value="@NullValue"><span class="qh-muted">@NullText</span></MudSelectItem>
    }
    @foreach (string location in Workspace.Config.Locations.Names)
    {
        <MudSelectItem T="string" Value="@location">
            <MudIcon Icon="@Ui.LocationIcon(location)" Size="Size.Small" Class="mr-2" Style="vertical-align:middle" />@location
        </MudSelectItem>
    }
</MudSelect>

@code {
    private const string NullValue = "__none__";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? NullText { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public string? Class { get; set; }

    private string Display(string? value) => value is null or NullValue ? NullText ?? "" : value;

    private Task OnChanged(string? value) => ValueChanged.InvokeAsync(value == NullValue ? null : value);
}
